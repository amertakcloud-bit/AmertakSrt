# ចម្លងឯកសារនេះទៅ ".env" រួចបំពេញតម្លៃ។ កុំ commit ឯកសារ ".env"។

# Gemini API Key លំនាំដើម (យកពី https://aistudio.google.com/apikey)
# អ្នកប្រើអាចបញ្ចូល Key ផ្ទាល់ខ្លួនតាម UI ដែលនឹងត្រូវប្រើជំនួស Key នេះ
GEMINI_API_KEY=

PORT=5000

# ទំហំ Audio អតិបរមា (MB) និងរយៈពេលអតិបរមា (នាទី)
MAX_FILE_MB=100
MAX_AUDIO_MINUTES=120

# Model សម្រាប់ Transcription + Word-level timestamps (Gemini Audio Transcription)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Model ជំនួស (Audio understanding) ប្រើពេល Transcribe model មិនអាចប្រើបាន
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# រយៈពេលអតិបរមាក្នុងមួយ Chunk (វិនាទី) — Transcribe + Timestamps កំណត់ត្រឹម 30 នាទី
CHUNK_SECONDS=1500

# កំណត់ចំនួន Request ក្នុងមួយ IP ក្នុង 10 នាទី (Transcribe/Align)
RATE_LIMIT_MAX=30

# ផ្លូវ ffmpeg ផ្ទាល់ខ្លួន (ជាជម្រើស; លំនាំដើមប្រើ ffmpeg-static)
# FFMPEG_PATH=ffmpeg-static
